# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://receptionist:receptionist_dev_password@localhost:5432/receptionist_platform

# Vector DB
QDRANT_URL=http://localhost:6333

# LLM — provider-swappable. Starting with Groq since it's already working
# from the voice receptionist project. Swap to Qwen3 later via LLM_PROVIDER.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Embedding model (runs locally via sentence-transformers, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Voice pipeline (Week 2) — reuse the same values from the voice
# receptionist project's .env
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your current ngrok URL, no trailing slash, e.g. https://abc123.ngrok-free.dev
PUBLIC_BASE_URL=
